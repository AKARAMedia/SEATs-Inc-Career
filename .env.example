# Postgres connection (Neon via Vercel Marketplace). Omit locally to use the embedded PGlite DB in ./.data
DATABASE_URL=

# First admin account — created automatically on first login when the admin_users table is empty
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Random 32+ byte secret for signing admin session cookies (required in production)
SESSION_SECRET=

# Canonical site URL used for metadata
SITE_URL=https://seatsinc-career.com
