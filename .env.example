# Postgres connection. Omit locally to use the embedded PGlite DB in ./.data (seeded via
# `npm run db:migrate` + `npm run db:import-jobs`). In production, set this to the SAME
# connection string as the seats-inc.com project — this app only ever reads from it; the
# seats-inc.com admin panel (Career Jobs + Career Site HR Contact) owns writes + migrations.
DATABASE_URL=

# Canonical site URL used for metadata
SITE_URL=https://seatsinc-career.com
