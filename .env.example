# Postgres connection. Omit locally to use the embedded PGlite DB in ./.data (seeded via
# `npm run db:migrate` + `npm run db:import-jobs`). In production, set this to the SAME
# connection string as the seats-inc.com project — this app only ever reads from it; the
# seats-inc.com admin panel (Career Jobs + Career Site HR Contact) owns writes + migrations.
DATABASE_URL=

# Where the job list comes from (open AND closed jobs). Defaults to production. To see what you
# Close/Open in a local seats-inc admin, point this at it in .env.local and restart `next dev`:
# JOBS_API_URL=http://localhost:3002/api/jobs/

# Canonical site URL used for metadata
SITE_URL=https://seatsinc-career.com

# Base URL of the seats-inc.com project. The on-site job application form (an alternative to
# the Telegram "Apply" link) is a client-side POST to its API — see src/components/ApplyForm.tsx.
NEXT_PUBLIC_SEATS_INC_URL=https://seats-inc.com
